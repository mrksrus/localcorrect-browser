{
  "manifest_version": 3,
  "name": "LocalCorrect",
  "version": "1.99.1",
  "description": "Offline English and German typo correction for the text field you are typing in.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {"scripts": ["background.js"], "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "LocalCorrect"},
  "commands": {
    "correct-text": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Correct the selection or the focused field"},
    "undo-correction": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Undo the last correction"}
  },
  "browser_specific_settings": {
    "gecko": {"id": "localcorrect@localcorrect.invalid", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}
  }
}
