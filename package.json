{
  "name": "localcorrect-browser",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/core.test.mjs tests/review.test.mjs tests/core-quality.test.mjs tests/shortcut.test.mjs tests/email-safety.test.mjs && node tests/dom.mjs && node tests/extension.mjs",
    "test:core": "node --test tests/core.test.mjs tests/review.test.mjs tests/core-quality.test.mjs tests/email-safety.test.mjs",
    "test:dom": "node tests/dom.mjs",
    "check": "npm test && node tests/email-dom.mjs && npm run build && node scripts/verify.mjs",
    "evaluate": "node tests/hillclimb.mjs",
    "evaluate:emails": "node tests/email-evaluate.mjs",
    "report:emails": "node scripts/email-report.mjs"
  },
  "devDependencies": {
    "dictionary-de": "3.0.0",
    "dictionary-de-at": "3.0.0",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "esbuild": "0.25.12",
    "nspell": "2.1.5",
    "playwright": "1.56.1"
  },
  "license": "GPL-3.0-only"
}
